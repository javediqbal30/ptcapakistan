# --- Neon ------------------------------------------------------------------
# Pooled connection string from the Neon console:
#   Neon dashboard -> your branch -> Connection Details -> Pooled connection
# The pooler (host ending in `.pooler.neon.tech`) is the right one for the
# HTTP driver used here.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Optional overrides ----------------------------------------------------
# Lead forms POST to /api/contact and /api/enroll by default. Set these only
# if you want a hosted form service (Formspree, Basin, ...) instead.
# PUBLIC_CONTACT_ENDPOINT=""
# PUBLIC_ENROLL_ENDPOINT=""
