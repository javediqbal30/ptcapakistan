---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getPosts } from '@lib/sanity';
import { formatDate } from '@lib/content';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';

const posts = await getPosts();

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
];
---

<BaseLayout
  seo={{
    title: 'Tax & Compliance Blog - Expert Guides',
    description: 'Practical tax and compliance guides from PTCA mentors - income tax, sales tax, SECP filings, HR and careers. Reviewed for accuracy.',
    canonical: '/blog/',
  }}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <h1 style="margin-top:1rem">PTCA Blog</h1>
      <p class="page-hero__lead">
        Guides, explainers and practitioner notes on taxation, corporate compliance and careers.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {posts.length === 0 ? (
        <p>No articles published yet. Check back soon.</p>
      ) : (
        <div class="grid grid--3">
          {posts.map((post) => (
            <article class="card card--hover blog-card">
              {post.imageUrl && (
                <a href={`/blog/${post.slug}/`} class="blog-card__media" aria-hidden="true" tabindex="-1">
                  <img src={`${post.imageUrl}?w=800&auto=format`} alt="" loading="lazy" decoding="async" />
                </a>
              )}
              <div class="blog-card__body">
                {post.category && <span class="badge badge--brand">{post.category}</span>}
                <h2 class="blog-card__title">
                  <a href={`/blog/${post.slug}/`}>{post.title}</a>
                </h2>
                <p>{post.excerpt}</p>
                <p class="blog-card__meta">
                  <span>{formatDate(new Date(post.publishedAt))}</span>
                  {post.authorName && <span> &middot; {post.authorName}</span>}
                </p>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
