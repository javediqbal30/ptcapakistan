---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroRotator from '@components/ui/HeroRotator.astro';
import HeroNetwork from '@components/ui/HeroNetwork.astro';
import { SITE, whatsappLink } from '@data/site';
import { getPublishedCourses, getPublishedMentors, getPublishedPosts, postPath, formatDate } from '@lib/content';
import { faqSchema } from '@lib/schema';
import SectionHead from '@components/ui/SectionHead.astro';
import CourseCard from '@components/ui/CourseCard.astro';
import MentorCard from '@components/ui/MentorCard.astro';
import Accordion from '@components/ui/Accordion.astro';
import CtaBanner from '@components/ui/CtaBanner.astro';
import Icon from '@components/ui/Icon.astro';
import { Image } from 'astro:assets';
import aboutImage from '@assets/about/About_PTCA.webp';

const courses = await getPublishedCourses();
const mentors = await getPublishedMentors();
const posts = (await getPublishedPosts()).slice(0, 3);

const homeFaqs = [
  {
    q: 'What courses does PTCA offer in Karachi?',
    a: 'PTCA offers six professional programmes: Advanced Certificate in Taxation & Litigation Course, Certified Sales Tax Specialist Course, Certified Human Resource Professional (CHRP) Course, Corporate Law and Secretarial Practices Course, Foundation Certification in Tax & Corporate Course, and Intellectual Property Course.',
  },
  {
    q: 'Are the courses available online or only on campus?',
    a: 'Most programmes are offered in physical (Karachi), online and hybrid modes. The mode varies by course and is listed on each course page.',
  },
  {
    q: 'Who can join PTCA programmes?',
    a: 'Courses are designed for students, graduates, accountants, lawyers, business owners and working professionals. Each course page lists its specific eligibility.',
  },
  {
    q: 'How do I enrol or confirm fees and batch dates?',
    a: 'Use the Enroll Now button or contact the admissions team on WhatsApp. Fees and batch schedules vary by intake and learning mode, so admissions confirms them directly.',
  },
  {
    q: 'Kya tax course online kiya ja sakta hai?',
    a: 'Ji haan. Kai programmes online aur hybrid mode mein available hain, is liye aap Karachi ke bahar se bhi seekh sakte hain.',
  },
];

const whyUs = [
  { icon: 'book', title: 'Practical course content', text: 'Training built around the tasks, documents and deadlines professionals handle every day.' },
  { icon: 'users', title: 'Professional trainers', text: 'Learn from practitioners with 15+ and 20+ years of on-the-job experience.' },
  { icon: 'briefcase', title: 'Career-focused learning', text: 'Develop skills that support employment, professional practice and business growth.' },
  { icon: 'globe', title: 'Flexible options', text: 'Physical, online and hybrid delivery so study fits around work and city.' },
];

const serving = [
  { index: '01', title: 'Students & graduates', text: 'Build practical knowledge and strengthen your professional profile.' },
  { index: '02', title: 'Accountants & lawyers', text: 'Develop applied taxation, litigation and compliance capabilities.' },
  { index: '03', title: 'Business owners', text: 'Understand obligations, documentation and corporate requirements.' },
  { index: '04', title: 'Working professionals', text: 'Upgrade job-relevant skills through flexible learning options.' },
];

const approach = [
  { title: 'Understand', text: 'Learn core concepts in a clear, structured sequence.' },
  { title: 'Practise', text: 'Work through realistic examples, exercises and professional documents.' },
  { title: 'Apply', text: 'Build confidence to use your skills in career and business settings.' },
];

const stats = [
  { value: '6', label: 'Professional programmes' },
  { value: '15+', label: 'Years mentor experience' },
  { value: '3', label: 'Learning modes' },
  { value: 'Karachi', label: 'Campus location' },
];

const careerPaths = courses.flatMap((c) => c.data.careerPaths).slice(0, 12);
---

<BaseLayout
  seo={{
    title: 'PTCA | Tax & Corporate Courses in Karachi, Pakistan',
    description: 'Practical taxation, sales tax, tax litigation, CHRP and corporate law and secretarial practices courses in Karachi. Online, physical and hybrid. Enrol at PTCA today.',
    canonical: '/',
    bareTitle: true,
  }}
  schemaNodes={[faqSchema(homeFaqs)]}
>
  <section class="hero">
    <div class="hero__bg" aria-hidden="true" data-parallax>
      <span class="hero__orb hero__orb--1"></span>
      <span class="hero__orb hero__orb--2"></span>
      <span class="hero__orb hero__orb--3"></span>
      <span class="hero__spotlight"></span>
      <HeroNetwork />
    </div>

    <div class="container hero__grid">
      <div class="hero__copy">
        <span class="eyebrow">Build your future in tax &amp; corporate</span>
        <h1 class="hero__title">
          <span class="hero__title-kicker">Develop Global</span>
          <span class="hero__title-line hero__title-line--accent">Business &amp; Taxation</span>
          <span class="hero__title-line hero__title-line--bold">Skills With PTCA</span>
        </h1>
        <p class="hero__lead">
          Master practical Tax &amp; Corporate skills through professional training
          designed to help students build expertise, advance their careers, and
          succeed in the modern professional world.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary btn--lg" href="/courses/">
            Explore Courses
            <Icon name="arrow-right" size={16} />
          </a>
          <a class="btn btn--outline btn--lg" href="/enroll/">Enrol Now</a>
          <a class="btn btn--whatsapp btn--lg" href={whatsappLink()} target="_blank" rel="noopener">
            <Icon name="whatsapp" size={18} />
            WhatsApp
          </a>
        </div>
        <ul class="hero__features">
          <li><Icon name="check-circle" size={18} /> Practical curriculum</li>
          <li><Icon name="check-circle" size={18} /> Flexible learning</li>
          <li><Icon name="check-circle" size={18} /> Career-focused training</li>
        </ul>
      </div>

      <HeroRotator />
    </div>
  </section>

  <section class="trust-strip">
    <div class="container trust-strip__grid">
      {stats.map((stat) => (
        <div class="stat">
          <div class="stat__value">{stat.value}</div>
          <div class="stat__label">{stat.label}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <span class="eyebrow">About PTCA</span>
          <h2 style="margin-top:1rem">Practical education for tax &amp; corporate careers</h2>
          <div class="prose" style="margin-top:1.25rem">
            <p>
              {SITE.legalName} provides professionally structured training that connects
              essential knowledge with the practical skills used in the workplace.
              Courses combine clear concepts, guided exercises, professional
              documentation and application-based learning.
            </p>
            <p>
              Programmes are designed for students, graduates, accountants, lawyers,
              entrepreneurs and working professionals who want applied, career-ready
              capability rather than theory alone.
            </p>
          </div>
          <a class="btn btn--outline" href="/about/" style="margin-top:1.5rem">
            More about PTCA
            <Icon name="arrow-right" size={15} />
          </a>
        </div>
        <div class="split__media">
          <Image
            src={aboutImage}
            alt="Students in a PTCA classroom studying professional tax and corporate training"
            widths={[480, 720, 960]}
            sizes="(min-width: 821px) 46vw, 100vw"
            quality={80}
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <SectionHead
        eyebrow="Professional programmes"
        title="Courses built for real practice"
        lead="Six structured programmes spanning taxation, litigation, sales tax, human resources, corporate secretarial practice and intellectual property."
        align="center"
      />
      <div class="grid grid--3">
        {courses.map((course) => <CourseCard course={course} />)}
      </div>
      <div style="margin-top:2.5rem; text-align:center">
        <a class="btn btn--primary btn--lg" href="/courses/">
          View all courses
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        eyebrow="Who we serve"
        title="Built for every stage of a professional journey"
        align="center"
      />
      <div class="grid grid--4">
        {serving.map((item) => (
          <div class="card card--hover">
            <span class="feature__index">{item.index}</span>
            <h3 style="margin-top:0.75rem">{item.title}</h3>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="split">
        <div>
          <span class="eyebrow">Training approach</span>
          <h2 style="margin-top:1rem">Understand. Practise. Apply.</h2>
          <div class="steps" style="margin-top:2rem">
            {approach.map((step) => (
              <div class="step">
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="split__media">
          <img
            src="/Training_approachs.webp"
            alt="PTCA training approach - understand, practise, apply"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        eyebrow="Why choose PTCA"
        title="Training that respects your time and your career"
        align="center"
      />
      <div class="grid grid--4">
        {whyUs.map((item) => (
          <div class="card card--hover">
            <div class="card__icon"><Icon name={item.icon as any} size={24} /></div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container">
      <SectionHead
        eyebrow="Our mentors"
        title="Learn from practising professionals"
        lead="PTCA's faculty combine senior corporate roles with long-standing teaching experience."
      />
      <div class="grid grid--2">
        {mentors.map((mentor) => <MentorCard mentor={mentor} />)}
      </div>
      <div style="margin-top:2rem">
        <a class="btn btn--primary" href="/mentors/">
          Meet all mentors
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        eyebrow="Career paths"
        title="Where these courses can take you"
        align="center"
      />
      <ul class="chip-list" style="justify-content:center">
        {careerPaths.map((role) => <li class="chip">{role}</li>)}
      </ul>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section section--soft">
      <div class="container">
        <SectionHead
          eyebrow="Resources"
          title="Practical guidance on Pakistan tax &amp; compliance"
          lead="Written and reviewed by practising professionals."
          align="center"
        />
        <div class="grid grid--3">
          {posts.map((post) => (
            <article class="card card--hover">
              <span class="badge badge--brand">{post.data.category}</span>
              <h3 style="margin-top:1rem">
                <a href={postPath(post)}>{post.data.title}</a>
              </h3>
              <p>{post.data.description}</p>
              <p style="font-size:var(--fs-2xs); color:var(--muted-2)">
                {formatDate(post.data.publishedAt)}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container container--narrow">
      <SectionHead
        eyebrow="FAQ"
        title="Common questions"
        align="center"
      />
      <Accordion
        items={homeFaqs.map((f) => ({ title: f.q, html: `<p>${f.a}</p>` }))}
        firstOpen
      />
    </div>
  </section>

  <CtaBanner
    title="Ready to start?"
    text="Tell us which course interests you and our admissions team will guide you through mode, batch dates and registration."
    primaryLabel="Enrol now"
    primaryHref="/enroll/"
  />
</BaseLayout>

<script>
  // Hero parallax: the decorative background layers drift with the cursor.
  // Only two CSS custom properties are written, and the movement itself is a
  // CSS transition - so the work per frame is negligible and the effect stays
  // smooth on low-end devices.
  const layer = document.querySelector<HTMLElement>('[data-parallax]');

  if (layer) {
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    let frame = 0;

    const onMove = (event: PointerEvent) => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        const rect = layer.parentElement?.getBoundingClientRect();
        if (!rect) return;

        // Normalised cursor position: 0 at the edges, 1 in the centre. The CSS
        // multiplies this by each layer's own depth factor.
        const x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
        const y = ((event.clientY - rect.top) / rect.height) * 2 - 1;

        layer.style.setProperty('--mx', x.toFixed(3));
        layer.style.setProperty('--my', y.toFixed(3));
        layer.style.setProperty('--px', `${event.clientX - rect.left}px`);
        layer.style.setProperty('--py', `${event.clientY - rect.top}px`);
      });
    };

    const enable = () => {
      if (reduceMotion.matches) return;
      window.addEventListener('pointermove', onMove, { passive: true });
    };

    const disable = () => {
      window.removeEventListener('pointermove', onMove);
      layer.style.setProperty('--mx', '0');
      layer.style.setProperty('--my', '0');
    };

    if (finePointer.matches) enable();
    finePointer.addEventListener('change', () => {
      if (finePointer.matches) enable();
      else disable();
    });
    reduceMotion.addEventListener('change', () => {
      if (reduceMotion.matches) disable();
      else if (finePointer.matches) enable();
    });
  }
</script>