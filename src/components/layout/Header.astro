---
import { PRIMARY_NAV, COURSE_MENU, CALC_MENU } from '@data/navigation';
import { SITE, telHref, mailHref} from '@data/site';
import { getPublishedCourses, coursePath } from '@lib/content';
import Icon from '@components/ui/Icon.astro';
import Logo from '@components/ui/Logo.astro';

const courses = await getPublishedCourses();
const byId = new Map(courses.map((c) => [c.id, c]));

/** Current path with trailing slash, used for active/aria-current states. */
const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<div class="topbar">
  <div class="container topbar__inner">
    <ul class="topbar__list">
      <li>
        <Icon name="pin" size={15} />
        <span>{SITE.address.line2}, {SITE.address.locality}</span>
      </li>
    </ul>
    <ul class="topbar__list">
      <li>
        <Icon name="phone" size={15} />
        <a href={telHref}>{SITE.phone.display}</a>
      </li>
      <li>
        <Icon name="mail" size={15} />
        <a href={mailHref}>{SITE.email}</a>
      </li>
      <li>
        <a
          href="https://ptca.zenslearn.org/"
          target="_blank"
          rel="noopener noreferrer"
          class="topbar__lms-link"
        >
          <Icon name="graduation" size={14} />
          <span>Student LMS</span>
        </a>
      </li>
    </ul>
  </div>
</div>

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label={`${SITE.shortName} home`}>
      <Logo size={48} decorative />
      <span class="brand__text">
        <span class="brand__name">{SITE.legalName}</span>
        <span class="brand__sub">{SITE.slogan}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      {PRIMARY_NAV.map((item) =>
        item.href === '/courses/' ? (
          <button
            class="nav__link"
            type="button"
            aria-expanded="false"
            aria-controls="courses-megamenu"
            data-megamenu-trigger="courses"
          >
            {item.label}
            <Icon name="chevron-down" size={12} />
          </button>
        ) : item.href === '/calculators/' ? (
          <button
            class="nav__link"
            type="button"
            aria-expanded="false"
            aria-controls="calc-megamenu"
            data-megamenu-trigger="calc"
          >
            {item.label}
            <Icon name="chevron-down" size={12} />
          </button>
        ) : (
          <a
            class="nav__link"
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        )
      )}
    </nav>

    <div class="header__actions">
      <a
        class="btn btn--lms btn--sm btn--desktop"
        href="https://ptca.zenslearn.org/"
        target="_blank"
        rel="noopener noreferrer"
        title="Student LMS Portal"
      >
        <Icon name="graduation" size={15} />
        <span>LMS</span>
      </a>
      <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" data-drawer-toggle>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Courses mega-menu -->
  <div class="megamenu" id="courses-megamenu" data-megamenu="courses">
    <div class="container megamenu__grid">
      {COURSE_MENU.map((group) => (
        <div class="megamenu__col">
          <h3>{group.label}</h3>
          <ul class="megamenu__list">
            {group.slugs.map((slug) => {
              const course = byId.get(slug);
              if (!course) return null;
              return (
                <li>
                  <a href={coursePath(course)}>{course.data.shortTitle}</a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
      <div class="megamenu__promo">
        <h3>Not sure where to start?</h3>
        <p>Talk to admissions and we will match you to the right programme, mode and batch.</p>
        <a class="btn btn--dark btn--sm" href="/admissions/" style="justify-self:start">
          View admissions
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
    </div>
  </div>

  <!-- Calculators mega-menu -->
  <div class="megamenu megamenu--calc" id="calc-megamenu" data-megamenu="calc">
    <div class="container megamenu__grid megamenu__grid--calc">
      {CALC_MENU.map((group) => (
        <div class="megamenu__col">
          <h3 class="megamenu__col-head">
            <Icon name={group.icon as any} size={16} />
            {group.label}
          </h3>
          <ul class="megamenu__list">
            {group.links.map((link) => (
              <li>
                <a href={`/calculators/${link.slug}/`}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div class="megamenu__promo">
        <h3>Free Pakistan Calculators</h3>
        <p>25+ calculators for tax, HR, payroll and corporate compliance — updated for 2026-27.</p>
        <a class="btn btn--dark btn--sm" href="/calculators/" style="justify-self:start">
          View all calculators
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
    </div>
  </div>
</header>

<div class="drawer" data-drawer>
  <div class="drawer__group">
    <p class="drawer__label">Menu</p>
    <ul class="drawer__links">
      {PRIMARY_NAV.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
  </div>

  <div class="drawer__group">
    <p class="drawer__label">Popular courses</p>
    <ul class="drawer__links">
      {courses.slice(0, 4).map((course) => (
        <li><a href={coursePath(course)}>{course.data.shortTitle}</a></li>
      ))}
    </ul>
  </div>

  <div class="drawer__group">
    <p class="drawer__label">Calculators</p>
    <ul class="drawer__links">
      <li><a href="/calculators/income-tax/">Income Tax Calculator</a></li>
      <li><a href="/calculators/net-salary/">Net Salary Calculator</a></li>
      <li><a href="/calculators/gratuity/">Gratuity Calculator</a></li>
      <li><a href="/calculators/eobi/">EOBI Calculator</a></li>
      <li><a href="/calculators/">All Calculators →</a></li>
    </ul>
  </div>

  <div class="drawer__group" style="display:grid;gap:0.75rem">
    <a
      class="btn btn--lms btn--block"
      href="https://ptca.zenslearn.org/"
      target="_blank"
      rel="noopener noreferrer"
      style="display:flex;align-items:center;justify-content:center;gap:0.5rem"
    >
      <Icon name="graduation" size={18} />
      <span>Student LMS Portal</span>
    </a>
    <a class="btn btn--primary btn--block" href="/enroll/">Enroll Now</a>
  </div>
</div>

<script>
  const header = document.querySelector('[data-header]');
  if (header) {
    const triggers = header.querySelectorAll<HTMLButtonElement>('[data-megamenu-trigger]');
    const panels   = header.querySelectorAll<HTMLElement>('[data-megamenu]');
    const drawerToggle = header.querySelector<HTMLButtonElement>('[data-drawer-toggle]');
    const drawer   = document.querySelector<HTMLElement>('[data-drawer]');

    function closeAll() {
      triggers.forEach((t) => t.setAttribute('aria-expanded', 'false'));
      panels.forEach((p) => p.classList.remove('is-open'));
    }

    triggers.forEach((trigger) => {
      const key   = trigger.dataset.megamenuTrigger!;
      const panel = header.querySelector<HTMLElement>(`[data-megamenu="${key}"]`);

      trigger.addEventListener('click', () => {
        const open = trigger.getAttribute('aria-expanded') === 'true';
        closeAll();
        if (!open) {
          trigger.setAttribute('aria-expanded', 'true');
          panel?.classList.add('is-open');
        }
      });
    });

    document.addEventListener('click', (e) => {
      if (!header.contains(e.target as Node)) closeAll();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll();
    });

    drawerToggle?.addEventListener('click', () => {
      const open = drawer?.classList.toggle('is-open');
      drawerToggle.setAttribute('aria-expanded', String(Boolean(open)));
      document.body.style.overflow = open ? 'hidden' : '';
    });

    drawer?.querySelectorAll('a').forEach((link) =>
      link.addEventListener('click', () => {
        drawer.classList.remove('is-open');
        document.body.style.overflow = '';
      })
    );
  }
</script>

<style>
  /* Calculators mega-menu — 3-column grid */
  .megamenu__grid--calc {
    grid-template-columns: repeat(3, 1fr) 220px;
  }

  .megamenu__col-head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--brand-600);
    font-size: var(--fs-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-3);
  }

  @media (max-width: 900px) {
    .megamenu__grid--calc {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
