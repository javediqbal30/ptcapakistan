---
/**
 * PTCA brand logo.
 * Uses `/ptcalogo-removebg.png` from public folder.
 */
interface Props {
  /** Rendered height of the logo artwork, in pixels. */
  size?: number;
  /** Decorative use (the parent already provides an accessible name). */
  decorative?: boolean;
}

const { size = 48, decorative = false } = Astro.props;

const alt = decorative ? '' : 'Prime Tax & Corporate Academy';

// Native aspect ratio of ptcalogo-removebg.png (537 x 465).
const width = Math.round((size * 537) / 465);
---

<img
  src="/ptcalogo-removebg.png"
  alt={alt}
  class="brand__mark"
  width={width}
  height={size}
  loading="eager"
  decoding="async"
  fetchpriority="high"
/>
