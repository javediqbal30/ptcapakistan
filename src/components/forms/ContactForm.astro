---
import { LEARNING_MODES, CITIES } from '@data/formOptions';
import Icon from '@components/ui/Icon.astro';

interface CourseOption {
  id: string;
  title: string;
}

interface Props {
  courses: CourseOption[];
  endpoint?: string;
}

/**
 * Default target is the local lead API, which validates and stores the enquiry
 * in Neon. `PUBLIC_CONTACT_ENDPOINT` overrides it for a hosted form service.
 */
const {
  courses,
  endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? '/api/contact/',
} = Astro.props;
---

<form class="form" id="contact-form" method="post" action={endpoint || undefined} data-endpoint={endpoint} novalidate>
  <div class="form-grid">
    <div class="field">
      <label for="c-name">Full name <span class="req">*</span></label>
      <input class="input" id="c-name" name="name" type="text" autocomplete="name" required data-rule="name" />
      <span class="field__error" data-error-for="c-name" aria-live="polite"></span>
    </div>

    <div class="field">
      <label for="c-phone">Mobile / WhatsApp <span class="req">*</span></label>
      <input class="input" id="c-phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel" placeholder="03XX XXXXXXX" required data-rule="phone" />
      <span class="field__error" data-error-for="c-phone" aria-live="polite"></span>
    </div>

    <div class="field">
      <label for="c-email">Email</label>
      <input class="input" id="c-email" name="email" type="email" autocomplete="email" />
    </div>

    <div class="field">
      <label for="c-city">City</label>
      <select class="select" id="c-city" name="city">
        <option value="">Select city</option>
        {CITIES.map((city) => <option value={city}>{city}</option>)}
      </select>
    </div>

    <div class="field">
      <label for="c-course">Course of interest</label>
      <select class="select" id="c-course" name="course">
        <option value="">Not sure yet</option>
        {courses.map((course) => <option value={course.id}>{course.title}</option>)}
      </select>
    </div>

    <div class="field">
      <label for="c-mode">Preferred mode</label>
      <select class="select" id="c-mode" name="mode">
        <option value="">No preference</option>
        {LEARNING_MODES.map((mode) => <option value={mode}>{mode}</option>)}
      </select>
    </div>

    <div class="field field--full">
      <label for="c-message">Your message <span class="req">*</span></label>
      <textarea class="textarea" id="c-message" name="message" rows={4} required data-rule="text"></textarea>
      <span class="field__error" data-error-for="c-message" aria-live="polite"></span>
    </div>
  </div>

  <label class="consent">
    <input type="checkbox" name="consent" value="yes" required data-rule="consent" />
    <span>I agree to be contacted by PTCA and accept the <a href="/privacy-policy/">privacy policy</a>.</span>
  </label>
  <span class="field__error" data-error-for="consent" aria-live="polite"></span>

  <div class="hp-field" aria-hidden="true">
    <label for="c-website">Website</label>
    <input id="c-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div>
    <button class="btn btn--primary btn--lg" type="submit">
      Send enquiry <Icon name="arrow-right" size={16} />
    </button>
  </div>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  if (form) {
    const labels: Record<string, string> = {
      'c-name': 'Please enter your full name.',
      'c-phone': 'Enter a valid mobile number, e.g. 0300 1234567.',
      'c-email': 'Enter a valid email address.',
      'c-message': 'Please write a short message.',
    };

    const valid: Record<string, (v: string) => boolean> = {
      name: (v) => /^[A-Za-z][A-Za-z\s.'-]{2,}$/.test(v),
      phone: (v) => /^(03\d{9}|\+923\d{9})$/.test(v.replace(/[\s-]/g, '')),
      email: (v) => v === '' || /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v),
      text: (v) => v.length >= 5,
    };

    const setError = (id: string, message: string) => {
      const slot = form.querySelector<HTMLElement>(`[data-error-for="${id}"]`);
      if (slot) slot.textContent = message;
      const input = form.querySelector<HTMLElement>(`#${id}`);
      if (input) input.setAttribute('aria-invalid', message ? 'true' : 'false');
    };

    form.addEventListener('submit', (event) => {
      let ok = true;
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-rule]').forEach((field) => {
        const rule = field.dataset.rule ?? 'text';
        const id = field.id;

        if (rule === 'consent') {
          if (!(field as HTMLInputElement).checked) {
            ok = false;
            setError('consent', 'Please accept the privacy policy.');
          } else setError('consent', '');
          return;
        }

        const check = valid[rule];
        if (check && check(field.value.trim())) {
          setError(id, '');
        } else {
          ok = false;
          setError(id, labels[id] ?? 'Please check this field.');
        }
      });

      if (!ok) {
        event.preventDefault();
        return;
      }

      if (String(new FormData(form).get('website') ?? '') !== '') {
        event.preventDefault();
        return;
      }

      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        event.preventDefault();
        window.alert('Thank you. Please also reach us on WhatsApp for a faster reply.');
        location.assign('/thank-you/');
        return;
      }

      // POST to the lead API ourselves so a 422 stays on the page (the browser
      // would otherwise navigate to a plain-text error response) and so a 5xx
      // can fall back to WhatsApp instead of losing the enquiry.
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;

      fetch(endpoint, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      })
        .then(async (response) => {
          if (response.ok) {
            location.assign('/thank-you/');
            return;
          }
          const message = (await response.text()).trim();
          throw new Error(message || 'Request failed');
        })
        .catch((error: unknown) => {
          if (button) button.disabled = false;
          const detail = error instanceof Error && error.message ? error.message : '';
          window.alert(
            detail
              ? `${detail}\n\nIf the problem continues, please reach us on WhatsApp.`
              : 'Sorry, we could not send your message. Please try again, or contact us on WhatsApp.'
          );
        });
    });
  }
</script>
