---
/**
 * NetSalaryCalc.astro
 * Pakistan Net Take-Home Salary Calculator
 * Gross → Net after income tax + EOBI + ESSI deductions.
 */
import { TAX_YEARS, CURRENT_TAX_YEAR } from '@data/taxSlabs';
---

<div class="nsc">
  <h2 class="calc-subheading">Net Take-Home Salary Calculator</h2>
  <p class="calc-lead">Calculate your exact net salary after tax, EOBI and ESSI deductions.</p>

  <form id="nsc-form" class="calc-form" novalidate>
    <div class="form-row">
      <label for="nsc-year" class="form-label">Tax Year</label>
      <select id="nsc-year" name="year" class="form-select">
        {TAX_YEARS.map((ty) => (
          <option value={ty.year} selected={ty.year === CURRENT_TAX_YEAR}>{ty.label}</option>
        ))}
      </select>
    </div>

    <div class="form-row">
      <label for="nsc-gross" class="form-label">Monthly Gross Salary (PKR)</label>
      <div class="input-wrap">
        <span class="input-prefix">Rs.</span>
        <input type="number" id="nsc-gross" name="gross" class="form-input" placeholder="e.g. 150,000" min="0" step="1000" required />
      </div>
      <span class="form-error" id="nsc-error" aria-live="polite"></span>
    </div>

    <div class="form-row">
      <label class="form-label">Deductions</label>
      <div class="toggle-group" role="group">
        <label class="toggle-btn"><input type="checkbox" id="nsc-eobi" checked /><span>EOBI</span></label>
        <label class="toggle-btn"><input type="checkbox" id="nsc-essi" checked /><span>ESSI</span></label>
      </div>
    </div>

    <button type="submit" class="btn btn--primary btn--block calc-submit">Calculate Net Salary</button>
  </form>

  <div id="nsc-result" class="nsc__result" hidden aria-live="polite">
    <div class="result-header">
      <div class="result-badge" id="nsc-badge"></div>
      <button type="button" class="result-reset" id="nsc-reset">↩ Recalculate</button>
    </div>
    <div class="result-cards">
      <div class="result-card result-card--main">
        <span class="result-card__label">Net Monthly Take-Home</span>
        <span class="result-card__value" id="nsc-net"></span>
      </div>
      <div class="result-card">
        <span class="result-card__label">Income Tax</span>
        <span class="result-card__value" id="nsc-tax"></span>
      </div>
      <div class="result-card">
        <span class="result-card__label">EOBI Deduction</span>
        <span class="result-card__value" id="nsc-eobi-val"></span>
      </div>
      <div class="result-card">
        <span class="result-card__label">ESSI Deduction</span>
        <span class="result-card__value" id="nsc-essi-val"></span>
      </div>
      <div class="result-card">
        <span class="result-card__label">Annual Net Salary</span>
        <span class="result-card__value" id="nsc-annual-net"></span>
      </div>
    </div>
  </div>
</div>

<script>
  const TAX_DATA: Record<string, {min:number;max:number;base:number;rate:number}[]> = {
    '2026-27': [{min:0,max:600000,base:0,rate:0},{min:600001,max:1200000,base:0,rate:0.01},{min:1200001,max:2200000,base:6000,rate:0.11},{min:2200001,max:3200000,base:116000,rate:0.20},{min:3200001,max:4100000,base:316000,rate:0.25},{min:4100001,max:5600000,base:541000,rate:0.29},{min:5600001,max:7000000,base:976000,rate:0.32},{min:7000001,max:Infinity,base:1424000,rate:0.35}],
    '2025-26': [{min:0,max:600000,base:0,rate:0},{min:600001,max:1200000,base:0,rate:0.01},{min:1200001,max:2200000,base:6000,rate:0.11},{min:2200001,max:3200000,base:116000,rate:0.23},{min:3200001,max:4100000,base:346000,rate:0.30},{min:4100001,max:Infinity,base:616000,rate:0.35}],
    '2024-25': [{min:0,max:600000,base:0,rate:0},{min:600001,max:1200000,base:0,rate:0.05},{min:1200001,max:2200000,base:30000,rate:0.15},{min:2200001,max:3200000,base:180000,rate:0.25},{min:3200001,max:4100000,base:430000,rate:0.30},{min:4100001,max:Infinity,base:700000,rate:0.35}],
    '2023-24': [{min:0,max:600000,base:0,rate:0},{min:600001,max:1200000,base:0,rate:0.025},{min:1200001,max:2400000,base:15000,rate:0.125},{min:2400001,max:3600000,base:165000,rate:0.225},{min:3600001,max:6000000,base:435000,rate:0.275},{min:6000001,max:Infinity,base:1095000,rate:0.35}],
    '2022-23': [{min:0,max:600000,base:0,rate:0},{min:600001,max:1200000,base:0,rate:0.025},{min:1200001,max:2400000,base:15000,rate:0.125},{min:2400001,max:3600000,base:165000,rate:0.20},{min:3600001,max:6000000,base:405000,rate:0.25},{min:6000001,max:Infinity,base:1005000,rate:0.325}],
  };
  const fmt = (n:number) => 'Rs. ' + Math.round(n).toLocaleString('en-PK');
  function calcTax(annual:number, year:string) {
    const slabs = TAX_DATA[year] || TAX_DATA['2026-27'];
    for (const s of slabs) { if (annual >= s.min && annual <= s.max) return s.base + (annual - s.min) * s.rate; }
    return 0;
  }
  const MIN_WAGE = 37000; // 2024-25 minimum wage
  const form = document.getElementById('nsc-form') as HTMLFormElement;
  const err = document.getElementById('nsc-error')!;
  const result = document.getElementById('nsc-result')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    err.textContent = '';
    const year = (document.getElementById('nsc-year') as HTMLSelectElement).value;
    const gross = parseFloat((document.getElementById('nsc-gross') as HTMLInputElement).value);
    const withEOBI = (document.getElementById('nsc-eobi') as HTMLInputElement).checked;
    const withESSI = (document.getElementById('nsc-essi') as HTMLInputElement).checked;
    if (!gross || gross < 0) { err.textContent = 'Please enter a valid salary.'; return; }
    const annual = gross * 12;
    const monthlyTax = calcTax(annual, year) / 12;
    // EOBI: employee 1% of min wage
    const eobi = withEOBI ? MIN_WAGE * 0.01 : 0;
    // ESSI: employee share ~ none (employer pays 6% of min wage); but some deduct 1/6 of 6% from employee
    const essi = withESSI ? MIN_WAGE * 0.06 * (1/6) : 0;
    const totalDeductions = monthlyTax + eobi + essi;
    const net = gross - totalDeductions;
    (document.getElementById('nsc-net')!).textContent = fmt(net);
    (document.getElementById('nsc-tax')!).textContent = fmt(monthlyTax);
    (document.getElementById('nsc-eobi-val')!).textContent = fmt(eobi);
    (document.getElementById('nsc-essi-val')!).textContent = fmt(essi);
    (document.getElementById('nsc-annual-net')!).textContent = fmt(net * 12);
    (document.getElementById('nsc-badge')!).textContent = `Net Salary — ${year}`;
    form.hidden = true; result.hidden = false;
    result.scrollIntoView({behavior:'smooth',block:'start'});
  });
  document.getElementById('nsc-reset')!.addEventListener('click', () => { form.reset(); form.hidden = false; result.hidden = true; });
</script>
