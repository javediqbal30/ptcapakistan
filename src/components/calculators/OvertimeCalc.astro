---
/**
 * OvertimeCalc.astro
 * Pakistan Overtime Pay Calculator — Factories Act: 2× hourly rate.
 */
---

<div class="otc">
  <h2 class="calc-subheading">Overtime Pay Calculator</h2>
  <p class="calc-lead">Calculate overtime wages under the Factories Act (2× hourly rate).</p>

  <form id="otc-form" class="calc-form" novalidate>
    <div class="form-row">
      <label for="otc-salary" class="form-label">Monthly Gross Salary (PKR)</label>
      <div class="input-wrap">
        <span class="input-prefix">Rs.</span>
        <input type="number" id="otc-salary" name="salary" class="form-input" placeholder="e.g. 60,000" min="0" step="1000" required />
      </div>
      <span class="form-error" id="otc-error" aria-live="polite"></span>
    </div>

    <div class="form-row">
      <label for="otc-hours" class="form-label">Overtime Hours</label>
      <input type="number" id="otc-hours" name="hours" class="form-input" placeholder="e.g. 20" min="0" step="0.5" required />
    </div>

    <div class="form-row">
      <label for="otc-wdays" class="form-label">Working Days per Month <span class="form-hint">default 26</span></label>
      <input type="number" id="otc-wdays" name="wdays" class="form-input" value="26" min="20" max="31" step="1" />
    </div>

    <div class="form-row">
      <label for="otc-hpd" class="form-label">Hours per Day <span class="form-hint">default 8</span></label>
      <input type="number" id="otc-hpd" name="hpd" class="form-input" value="8" min="4" max="12" step="0.5" />
    </div>

    <button type="submit" class="btn btn--primary btn--block calc-submit">Calculate Overtime</button>
  </form>

  <div id="otc-result" class="otc__result" hidden aria-live="polite">
    <div class="result-header">
      <div class="result-badge">Factories Act OT</div>
      <button type="button" class="result-reset" id="otc-reset">↩ Recalculate</button>
    </div>
    <div class="result-cards">
      <div class="result-card result-card--main">
        <span class="result-card__label">Total Overtime Pay</span>
        <span class="result-card__value" id="otc-total"></span>
      </div>
      <div class="result-card">
        <span class="result-card__label">Hourly Rate (1×)</span>
        <span class="result-card__value" id="otc-hourly"></span>
      </div>
      <div class="result-card">
        <span class="result-card__label">OT Rate (2×)</span>
        <span class="result-card__value" id="otc-ot-rate"></span>
      </div>
      <div class="result-card">
        <span class="result-card__label">Total with Salary</span>
        <span class="result-card__value" id="otc-grand"></span>
      </div>
    </div>
  </div>
</div>

<script>
  const fmt = (n:number) => 'Rs. ' + Math.round(n).toLocaleString('en-PK');
  const form = document.getElementById('otc-form') as HTMLFormElement;
  const err = document.getElementById('otc-error')!;
  const result = document.getElementById('otc-result')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    err.textContent = '';
    const salary = parseFloat((document.getElementById('otc-salary') as HTMLInputElement).value);
    const hours = parseFloat((document.getElementById('otc-hours') as HTMLInputElement).value);
    const wdays = parseInt((document.getElementById('otc-wdays') as HTMLInputElement).value) || 26;
    const hpd = parseFloat((document.getElementById('otc-hpd') as HTMLInputElement).value) || 8;
    if (!salary || salary < 0) { err.textContent = 'Please enter a valid salary.'; return; }
    if (!hours || hours < 0) { err.textContent = 'Please enter valid overtime hours.'; return; }
    const totalWorkHours = wdays * hpd;
    const hourlyRate = salary / totalWorkHours;
    const otRate = hourlyRate * 2;
    const otPay = otRate * hours;
    const grand = salary + otPay;
    (document.getElementById('otc-total')!).textContent = fmt(otPay);
    (document.getElementById('otc-hourly')!).textContent = fmt(hourlyRate);
    (document.getElementById('otc-ot-rate')!).textContent = fmt(otRate);
    (document.getElementById('otc-grand')!).textContent = fmt(grand);
    form.hidden = true; result.hidden = false;
    result.scrollIntoView({behavior:'smooth',block:'start'});
  });
  document.getElementById('otc-reset')!.addEventListener('click', () => { form.reset(); form.hidden = false; result.hidden = true; });
</script>
