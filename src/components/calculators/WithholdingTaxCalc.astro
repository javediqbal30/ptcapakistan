---
/**
 * WithholdingTaxCalc.astro
 * Pakistan Withholding Tax on Salary — Section 149, Income Tax Ordinance 2001
 * Employer deducts monthly tax by projecting annual salary.
 */
import { TAX_YEARS, CURRENT_TAX_YEAR } from '@data/taxSlabs';
---

<div class="wht">
  <h2 class="calc-subheading">Withholding Tax Calculator</h2>
  <p class="calc-lead">Section 149 — Calculate monthly withholding tax deduction by employer.</p>

  <form id="wht-form" class="calc-form" novalidate>
    <div class="form-row">
      <label for="wht-year" class="form-label">Tax Year</label>
      <select id="wht-year" name="year" class="form-select">
        {TAX_YEARS.map((ty) => (
          <option value={ty.year} selected={ty.year === CURRENT_TAX_YEAR}>{ty.label}</option>
        ))}
      </select>
    </div>

    <div class="form-row">
      <label for="wht-monthly" class="form-label">Monthly Gross Salary (PKR)</label>
      <div class="input-wrap">
        <span class="input-prefix">Rs.</span>
        <input type="number" id="wht-monthly" name="monthly" class="form-input" placeholder="e.g. 150,000" min="0" step="1000" required />
      </div>
      <span class="form-error" id="wht-error" aria-live="polite"></span>
    </div>

    <div class="form-row">
      <label for="wht-months" class="form-label">Months Worked <span class="form-hint">(default 12)</span></label>
      <input type="number" id="wht-months" name="months" class="form-input" value="12" min="1" max="12" />
    </div>

    <button type="submit" class="btn btn--primary btn--block calc-submit">Calculate Withholding Tax</button>
  </form>

  <div id="wht-result" class="wht__result" hidden aria-live="polite">
    <div class="result-header">
      <div class="result-badge" id="wht-badge"></div>
      <button type="button" class="result-reset" id="wht-reset">↩ Recalculate</button>
    </div>
    <div class="result-cards">
      <div class="result-card result-card--main">
        <span class="result-card__label">Monthly Tax Deduction</span>
        <span class="result-card__value" id="wht-monthly-tax"></span>
      </div>
      <div class="result-card">
        <span class="result-card__label">Annual Tax Liability</span>
        <span class="result-card__value" id="wht-annual-tax"></span>
      </div>
      <div class="result-card">
        <span class="result-card__label">Annual Gross Salary</span>
        <span class="result-card__value" id="wht-annual-income"></span>
      </div>
      <div class="result-card">
        <span class="result-card__label">Net Monthly Salary</span>
        <span class="result-card__value" id="wht-net-monthly"></span>
      </div>
    </div>
  </div>
</div>

<script>
  const TAX_DATA: Record<string, {min:number;max:number;base:number;rate:number}[]> = {
    '2026-27': [{min:0,max:600000,base:0,rate:0},{min:600001,max:1200000,base:0,rate:0.01},{min:1200001,max:2200000,base:6000,rate:0.11},{min:2200001,max:3200000,base:116000,rate:0.20},{min:3200001,max:4100000,base:316000,rate:0.25},{min:4100001,max:5600000,base:541000,rate:0.29},{min:5600001,max:7000000,base:976000,rate:0.32},{min:7000001,max:Infinity,base:1424000,rate:0.35}],
    '2025-26': [{min:0,max:600000,base:0,rate:0},{min:600001,max:1200000,base:0,rate:0.01},{min:1200001,max:2200000,base:6000,rate:0.11},{min:2200001,max:3200000,base:116000,rate:0.23},{min:3200001,max:4100000,base:346000,rate:0.30},{min:4100001,max:Infinity,base:616000,rate:0.35}],
    '2024-25': [{min:0,max:600000,base:0,rate:0},{min:600001,max:1200000,base:0,rate:0.05},{min:1200001,max:2200000,base:30000,rate:0.15},{min:2200001,max:3200000,base:180000,rate:0.25},{min:3200001,max:4100000,base:430000,rate:0.30},{min:4100001,max:Infinity,base:700000,rate:0.35}],
    '2023-24': [{min:0,max:600000,base:0,rate:0},{min:600001,max:1200000,base:0,rate:0.025},{min:1200001,max:2400000,base:15000,rate:0.125},{min:2400001,max:3600000,base:165000,rate:0.225},{min:3600001,max:6000000,base:435000,rate:0.275},{min:6000001,max:Infinity,base:1095000,rate:0.35}],
    '2022-23': [{min:0,max:600000,base:0,rate:0},{min:600001,max:1200000,base:0,rate:0.025},{min:1200001,max:2400000,base:15000,rate:0.125},{min:2400001,max:3600000,base:165000,rate:0.20},{min:3600001,max:6000000,base:405000,rate:0.25},{min:6000001,max:Infinity,base:1005000,rate:0.325}],
  };
  const fmt = (n:number) => 'Rs. ' + Math.round(n).toLocaleString('en-PK');
  function calcTax(annual:number, year:string) {
    const slabs = TAX_DATA[year] || TAX_DATA['2026-27'];
    for (const s of slabs) { if (annual >= s.min && annual <= s.max) return s.base + (annual - s.min) * s.rate; }
    return 0;
  }
  const form = document.getElementById('wht-form') as HTMLFormElement;
  const err = document.getElementById('wht-error')!;
  const result = document.getElementById('wht-result')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    err.textContent = '';
    const year = (document.getElementById('wht-year') as HTMLSelectElement).value;
    const monthly = parseFloat((document.getElementById('wht-monthly') as HTMLInputElement).value);
    if (!monthly || monthly < 0) { err.textContent = 'Please enter a valid salary.'; return; }
    const annual = monthly * 12;
    const annualTax = calcTax(annual, year);
    const monthlyTax = annualTax / 12;
    const netMonthly = monthly - monthlyTax;
    (document.getElementById('wht-monthly-tax')!).textContent = fmt(monthlyTax);
    (document.getElementById('wht-annual-tax')!).textContent = fmt(annualTax);
    (document.getElementById('wht-annual-income')!).textContent = fmt(annual);
    (document.getElementById('wht-net-monthly')!).textContent = fmt(netMonthly);
    (document.getElementById('wht-badge')!).textContent = `Section 149 — ${year}`;
    form.hidden = true; result.hidden = false;
    result.scrollIntoView({behavior:'smooth',block:'start'});
  });
  document.getElementById('wht-reset')!.addEventListener('click', () => { form.reset(); form.hidden = false; result.hidden = true; });
</script>
