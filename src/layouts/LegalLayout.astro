---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<BaseLayout
  seo={{ title, description, canonical: Astro.url.pathname }}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: title, path: Astro.url.pathname }]} />
      <h1>{title}</h1>
      <p style="margin-top:0.75rem; font-size:var(--fs-xs); color:var(--muted-2)">
        Last updated: {updated}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <div class="prose">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>